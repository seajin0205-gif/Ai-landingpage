# Copy to .env.local. Never commit real secrets.

# SQLite file created on first request. Defaults to data/nexus.sqlite.
DATABASE_PATH=

# Signs session token hashes. Change this before any shared deployment.
SESSION_SECRET=replace-with-a-long-random-string

# Optional. When unset, chat/image/automation stay on the local preview provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=dall-e-3

# Optional lead notifications. Saving the lead does not depend on these.
LEAD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
